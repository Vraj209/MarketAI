generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  admin
  business_owner
  team_member
}

enum CampaignStatus {
  draft
  active
  archived
}

enum AssetType {
  strategy
  social_post
  email
  newsletter
  report
  website_audit
  deck_outline
}

enum AgentRunStatus {
  success
  failed
}

model User {
  id             String            @id @default(cuid())
  name           String?
  email          String            @unique
  emailVerified  DateTime?
  image          String?
  accounts       Account[]
  sessions       Session[]
  memberships    WorkspaceMember[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Workspace {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  members         WorkspaceMember[]
  businessProfile BusinessProfile?
  campaigns       Campaign[]
  generatedAssets GeneratedAsset[]
  websiteAudits   WebsiteAudit[]
  reports         Report[]
  agentRuns       AgentRun[]
  promptLogs      PromptLog[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(team_member)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
}

model BusinessProfile {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  category    String
  websiteUrl  String?
  location    String
  audience    String
  lifecycle   String
  goals       String
  brandVoice  String
  competitors String?
  challenges  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaigns   Campaign[]
  assets      GeneratedAsset[]
  websiteAudits WebsiteAudit[]
  reports     Report[]
  agentRuns   AgentRun[]

  @@index([name])
}

model Campaign {
  id               String         @id @default(cuid())
  workspaceId      String
  businessProfileId String
  title            String
  objective        String
  channels         String[]
  strategySummary  String
  status           CampaignStatus @default(draft)
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessProfile  BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([workspaceId, status])
  @@index([businessProfileId, createdAt])
}

model GeneratedAsset {
  id               String         @id @default(cuid())
  workspaceId      String
  businessProfileId String
  type             AssetType
  title            String
  payload          Json
  sourcePrompt     String?
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessProfile  BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([workspaceId, type, createdAt])
  @@index([businessProfileId, createdAt])
}

model WebsiteAudit {
  id               String          @id @default(cuid())
  workspaceId      String
  businessProfileId String
  websiteUrl       String
  findings         Json
  recommendations  Json
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessProfile  BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([workspaceId, createdAt])
  @@index([businessProfileId, createdAt])
}

model Report {
  id               String          @id @default(cuid())
  workspaceId      String
  businessProfileId String
  title            String
  payload          Json
  assumptions      Json?
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessProfile  BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([workspaceId, createdAt])
}

model AgentRun {
  id               String          @id @default(cuid())
  workspaceId      String
  businessProfileId String?
  intent           String
  input            String
  outputJson       String
  status           AgentRunStatus
  traceId          String
  logs             Json?
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessProfile  BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([workspaceId, createdAt])
  @@index([traceId])
}

model PromptLog {
  id          String    @id @default(cuid())
  workspaceId String
  promptKey   String
  promptBody  String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, promptKey])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}
